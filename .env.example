APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# TASK-012 — leave SANCTUM_STATEFUL_DOMAINS UNSET to keep the default:
# localhost/127.0.0.1/::1 + APP_URL + the host actually serving each
# request (dashboard use from phones on the LAN works out of the box).
# Set it ONLY to pin stateful session auth to an explicit host list, e.g.
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,192.168.1.6:8000
# An EMPTY uncommented value would disable ALL stateful hosts — avoid it.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Presence Platform — recycling classifier & NL query
# Copy this file to .env and fill in your own values.
# NEVER commit real keys to the repository.
# ------------------------------------------------------------------

# Classifier driver: stub | local | gemini
RECYCLING_CLASSIFIER_DRIVER=stub

# Local model-inference endpoint (used when driver=local). See docs/LOCAL_MODEL.md
LOCAL_CLASSIFIER_URL=http://127.0.0.1:8501/v1/models/material:predict
LOCAL_CLASSIFIER_TIMEOUT=10

# Gemini API (flash-family models only — free tier friendly; default
# gemini-3.1-flash-lite). Live calls are skipped entirely when the key is
# empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=20

# Teacher-dashboard "late" cutoff (HH:MM, school local time)
ATTENDANCE_LATE_CUTOFF=08:15
